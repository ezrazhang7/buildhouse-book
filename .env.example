# Required. The one password BuildHouse gives mentors (8+ characters; use a long phrase).
MENTOR_PASSWORD=
# Required. 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Shown on the cover.
BOOK_EDITION=Fall 2026
# Fallback address shown if a mentor's offer cannot be delivered.
CONTACT_EMAIL=

# Optional: live sheet sync and saving offers to the sheet. Without these the book builds from content/profiles.json.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=11o7MLjkS-HU14_t_nFLgDzpyPxWRLEpHSMv9J65jlJk
PROFILES_TAB=Profiles
OFFERS_TAB=Mentor offers
# Optional: also POST each offer as JSON here (Slack workflow, Apps Script, Zapier).
OFFERS_WEBHOOK_URL=

# Local development only. AUTH_BYPASS=1 opens the book on your own machine with no password.
# Ignored when NODE_ENV=production and on every Vercel deployment, and the server refuses to boot
# if it is set on one. Never add this in Vercel: give Preview its own MENTOR_PASSWORD value instead.
AUTH_BYPASS=
